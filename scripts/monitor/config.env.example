# ==============================================================================
# System Monitor & Alert Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ALERT CHANNELS (Bật/Tắt các kênh gửi thông báo)
# ------------------------------------------------------------------------------
ENABLE_TELEGRAM=true
ENABLE_LARK=false

# Telegram Bot Config
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# Lark Suite Webhook Config
LARK_WEBHOOK_URL="https://open.larksuite.com/open-apis/bot/v2/hook/your_lark_webhook_uuid_here"

# ------------------------------------------------------------------------------
# 2. MONITORING THRESHOLDS (Các ngưỡng kích hoạt cảnh báo)
# ------------------------------------------------------------------------------
RAM_THRESHOLD_PERCENT=85       # Cảnh báo khi RAM vượt quá 85%
CPU_THRESHOLD_PERCENT=90       # Cảnh báo khi CPU vượt quá 90%
DISK_THRESHOLD_PERCENT=90      # Cảnh báo khi Ổ cứng vượt quá 90%

# ------------------------------------------------------------------------------
# 3. SECURITY OPTIONS
# ------------------------------------------------------------------------------
# Quét tìm malware/tiến trình đào coin chạy ẩn
SCAN_SUSPICIOUS_PATHS=true     # Kiểm tra các tiến trình chạy từ /tmp, /dev/shm, /var/tmp
ENABLE_SSH_MONITOR=true        # Cảnh báo khi có lượt đăng nhập SSH thành công mới
