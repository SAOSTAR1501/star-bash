{
    "msg_type": "interactive",
    "card": {
        "config": {
            "wide_screen_mode": true,
            "enable_forward": true
        },
        "header": {
            "template": "green",
            "title": {
                "tag": "plain_text",
                "content": "Push Event - {{project.name}}"
            }
        },
        "elements": [
            {
                "tag": "div",
                "text": {
                    "tag": "lark_md",
                    "content": "🚀 **Pushed {{total_commits_count}} commit(s)** to branch `{{ref}}`"
                }
            },
            {
                "tag": "hr"
            },
            {
                "tag": "div",
                "fields": [
                    {
                        "is_short": true,
                        "text": {
                            "tag": "lark_md",
                            "content": "👤 **Author:**\n<font color='blue'>{{user_name}}</font>"
                        }
                    },
                    {
                        "is_short": true,
                        "text": {
                            "tag": "lark_md",
                            "content": "🌿 **Target Branch:**\n`{{ref}}`"
                        }
                    }
                ]
            },
            {
                "tag": "hr"
            },
            {
                "tag": "note",
                "elements": [
                    {
                        "tag": "plain_text",
                        "content": "🆔 Checkout SHA: {{checkout_sha}}"
                    }
                ]
            },
            {
                "tag": "action",
                "actions": [
                    {
                        "tag": "button",
                        "text": {
                            "tag": "plain_text",
                            "content": "View Repository"
                        },
                        "type": "primary",
                        "url": "{{project.web_url}}"
                    },
                    {
                        "tag": "button",
                        "text": {
                            "tag": "plain_text",
                            "content": "Compare Changes"
                        },
                        "type": "default",
                        "url": "{{project.web_url}}/-/compare/{{before}}...{{after}}"
                    }
                ]
            }
        ]
    }
}